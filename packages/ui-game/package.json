{
  "name": "@vxnus/ui-game",
  "version": "0.1.0",
  "description": "Themeable game UI and chrome components for VXNUS game knowledge bases",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vxnuslabs/vxnus.git",
    "directory": "packages/ui-game"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
